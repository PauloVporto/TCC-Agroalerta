# Copie este arquivo para ".env" e preencha com suas chaves reais.
# Sem essas chaves, o sistema roda em MODO SIMULADO (dados fictícios),
# então dá pra testar tudo mesmo sem ter as chaves ainda.

# Chave da API de clima (OpenWeatherMap - plano gratuito funciona)
# Crie a sua em: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Chave da API de IA para o módulo de análise de mercado (Módulo 4)
# Pode ser da Anthropic (Claude) ou OpenAI - o código já vem pronto para Anthropic
ANTHROPIC_API_KEY=

# Chave da API Alpha Vantage para cotações internacionais de commodities
# Plano gratuito: 25 requisições/dia. Crie em: https://www.alphavantage.co/support/#api-key
# Se não configurada, o sistema usa Stooq como fallback (gratuito, sem chave)
ALPHA_VANTAGE_KEY=

# (Opcional) Código da série SGS do Banco Central usada no card de commodities agropecuárias.
# Se vazio, tenta 27575 e 29039. Confirme o código em https://www3.bcb.gov.br/sgspub
BCB_ICBR_SERIE=

# Mapas e geocodificação: OpenStreetMap (Nominatim) - gratuito, sem chave necessária.
# Não é preciso configurar nada aqui; o sistema usa o Nominatim automaticamente.

# ---- Notificações: e-mail (Resend) e SMS (SMSGo) ----
# Guia completo: docs/NOTIFICACOES.md. Diagnóstico das contas (não envia nada):
#   docker compose exec backend npm run notificacoes:diagnostico
#
# Com *_SENDING_ENABLED=false (padrão) o canal fica em MODO SIMULADO: a fila, os
# limites e o histórico funcionam, mas nenhuma chamada externa é feita (sem custo).
# Só ative o envio real depois de validar cada provedor com os scripts de teste.

# E-mail pelo Resend — https://resend.com/api-keys
EMAIL_PROVIDER=resend
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
# Sem domínio verificado no Resend, use o remetente de teste: ele só entrega
# para o e-mail dono da conta. Para enviar a qualquer produtor, verifique um
# domínio e use-o aqui, ex.: Agro Alerta <alertas@seudominio.com.br>
EMAIL_FROM=Agro Alerta <onboarding@resend.dev>
# (Opcional) segredo whsec_... do webhook do Resend (exige URL HTTPS pública)
RESEND_WEBHOOK_SECRET=

# SMS pela SMSGo — painel em smsgo.com.br → Minha conta → API
SMS_PROVIDER=smsgo
SMS_SENDING_ENABLED=false
# Chave de produção e chave de teste (prefixo test_: sandbox, não cobra nem entrega)
SMSGO_API_KEY=
SMSGO_TEST_API_KEY=
# true (padrão) = os envios automáticos usam a chave de teste. Para SMS real: false
SMSGO_SANDBOX=true
# (Opcional) tipo de SMS da tabela da conta; o diagnóstico lista os tipos e preços
SMSGO_SMS_TYPE_ID=
# (Opcional) segredo do webhook da SMSGo (exige URL HTTPS pública)
SMSGO_WEBHOOK_SECRET=

# Twilio (legado, opcional): use SMS_PROVIDER=twilio para voltar a ela
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio no formato E.164, ex: +15551234567
TWILIO_FROM=

# Custos e limites do SMS. O SMS real só é enviado com custo e orçamento definidos.
# Preencha o custo com o preço da SUA conta (o diagnóstico mostra a tabela atual).
SMS_COST_PER_SEGMENT=
# Orçamento máximo por mês, em R$
SMS_MONTHLY_BUDGET=
SMS_DAILY_LIMIT=20
SMS_MONTHLY_LIMIT=200
SMS_PER_USER_DAILY_LIMIT=3
# 1 segmento = até 160 caracteres sem acento (os textos já saem sem acentos)
SMS_MAX_SEGMENTS=1

# Fila e monitoramento climático automático (Open-Meteo)
NOTIFICATION_QUEUE_INTERVAL_MS=15000
NOTIFICATION_MAX_ATTEMPTS=5
WEATHER_MONITOR_ENABLED=true
WEATHER_MONITOR_INTERVAL_MINUTES=60

# Porta do servidor (opcional)
PORT=3001

# Conexão PostgreSQL (no Docker, o compose substitui "localhost" por "db")
DATABASE_URL=postgres://agroalerta:agroalerta@localhost:5432/agroalerta
