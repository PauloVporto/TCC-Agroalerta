# Copie este arquivo para ".env" e preencha com suas chaves reais.
# Sem essas chaves, o sistema roda em MODO SIMULADO (dados fictícios),
# então dá pra testar tudo mesmo sem ter as chaves ainda.

# Provedor de clima: openmeteo (padrão, sem chave) ou openweather
WEATHER_PROVIDER=openmeteo

# Opcional: só é usada se WEATHER_PROVIDER=openweather
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Chave da API de IA para o módulo de análise de mercado (Módulo 4)
# Use uma chave da API Anthropic; chaves OpenAI e tokens de login não são compatíveis.
ANTHROPIC_API_KEY=
# Timeout da API em ms (1000 a 60000). Alterações em .env exigem reiniciar o backend.
ANTHROPIC_TIMEOUT_MS=15000

# Chave da API Alpha Vantage para cotações internacionais de commodities
# Plano gratuito: 25 requisições/dia. Crie em: https://www.alphavantage.co/support/#api-key
# Se não configurada, o sistema usa Stooq como fallback (gratuito, sem chave)
ALPHA_VANTAGE_KEY=

# (Opcional) Código da série SGS do Banco Central usada no card de commodities agropecuárias.
# Se vazio, tenta 27575 e 29039. Confirme o código em https://www3.bcb.gov.br/sgspub
BCB_ICBR_SERIE=

# Mapas e geocodificação: OpenStreetMap (Nominatim) - gratuito, sem chave necessária.
# Não é preciso configurar nada aqui; o sistema usa o Nominatim automaticamente.

# ---- Notificações: e-mail (Resend) e WhatsApp (Evolution API) ----
# Guias: docs/NOTIFICACOES.md e docs/WHATSAPP_EVOLUTION.md. Diagnóstico (não envia nada):
#   docker compose -f docker-compose.yml -f docker-compose.whatsapp.yml exec backend npm run notificacoes:diagnostico

# E-mail pelo Resend — https://resend.com/api-keys
# Com EMAIL_SENDING_ENABLED=false (padrão) o e-mail fica em MODO SIMULADO: a fila e o
# histórico funcionam, mas nenhuma chamada externa é feita.
EMAIL_PROVIDER=resend
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
# Sem domínio verificado no Resend, use o remetente de teste: ele só entrega
# para o e-mail dono da conta. Para enviar a qualquer produtor, verifique um
# domínio e use-o aqui, ex.: Agro Alerta <alertas@seudominio.com.br>
EMAIL_FROM=Agro Alerta <onboarding@resend.dev>
# (Opcional) segredo whsec_... do webhook do Resend (exige URL HTTPS pública)
RESEND_WEBHOOK_SECRET=

# WhatsApp pela Evolution API (instância única "agroalerta", número do Agro Alerta).
# Trava da implantação: com false (padrão) nenhuma mensagem de WhatsApp sai, mesmo
# liberada no painel — as mensagens esperam na fila até a validade. Só ligue para a
# validação real autorizada.
WHATSAPP_SENDING_ENABLED=false
# Número (ou só o final) do WhatsApp que deve estar conectado. Outro número conectado
# bloqueia os envios. Vazio: nada é enviado.
WHATSAPP_EXPECTED_SENDER=9503
# Ritmo de envio (protege o número de bloqueio por excesso de mensagens)
WHATSAPP_MIN_INTERVAL_MS=4000
WHATSAPP_HOURLY_LIMIT=30
WHATSAPP_DAILY_LIMIT=100
WHATSAPP_PER_USER_DAILY_LIMIT=5
# Conexão com a Evolution API: o docker-compose.whatsapp.yml já define estas variáveis
# (com as chaves em Docker secrets). Preencha só para rodar o backend fora do Docker.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=agroalerta
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_REQUEST_TIMEOUT_MS=30000

# Fila e monitoramento climático automático (Open-Meteo)
NOTIFICATION_QUEUE_INTERVAL_MS=15000
NOTIFICATION_MAX_ATTEMPTS=5
# Desligado por padrão: o monitoramento automático só roda com autorização explícita (true).
WEATHER_MONITOR_ENABLED=false
WEATHER_MONITOR_INTERVAL_MINUTES=60

# Porta do servidor (opcional)
PORT=3001

# Conexão PostgreSQL (no Docker, o compose substitui "localhost" por "db")
DATABASE_URL=postgres://agroalerta:agroalerta@localhost:5432/agroalerta

# Novas categorias permanecem bloqueadas até autorização do proprietário.
WEATHER_BULLETIN_ENABLED=false
WEATHER_EXTENDED_ALERTS_ENABLED=false
WEATHER_BULLETIN_WINDOW_MINUTES=30
# Critérios meteorológicos operacionais; calibrar localmente antes da ativação.
WEATHER_RAIN_MEDIUM_MM_DAY=50
WEATHER_RAIN_HIGH_MM_DAY=100
WEATHER_RAIN_ESCALATION_MM=20
WEATHER_WIND_MEDIUM_KMH=40
WEATHER_WIND_HIGH_KMH=60
WEATHER_WIND_ESCALATION_KMH=20
WEATHER_HEAT_MEDIUM_C=35
WEATHER_HEAT_HIGH_C=40
WEATHER_HEAT_ESCALATION_C=3
