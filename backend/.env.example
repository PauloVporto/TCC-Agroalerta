# Copie este arquivo para ".env" e preencha com suas chaves reais.
# Sem essas chaves, o sistema roda em MODO SIMULADO (dados fictícios),
# então dá pra testar tudo mesmo sem ter as chaves ainda.

# Provedor de clima: openmeteo (padrão, sem chave) ou openweather
WEATHER_PROVIDER=openmeteo

# Opcional: só é usada se WEATHER_PROVIDER=openweather
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Chave da API de IA para o módulo de análise de mercado (Módulo 4)
# Pode ser da Anthropic (Claude) ou OpenAI - o código já vem pronto para Anthropic
ANTHROPIC_API_KEY=

# Mapas e geocodificação: OpenStreetMap (Nominatim) - gratuito, sem chave necessária.
# Não é preciso configurar nada aqui; o sistema usa o Nominatim automaticamente.

# ---- Notificações do produtor (e-mail + SMS) ----
# Sem essas chaves o sistema SIMULA o envio (loga no console e marca na mensagem).
# SMTP (Gmail app password, Mailtrap, SendGrid SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AgroAlerta <alertas@seudominio.com>"

# Twilio SMS — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio no formato E.164, ex: +15551234567
TWILIO_FROM=

# Porta do servidor (opcional)
PORT=3001

# Conexão PostgreSQL (no Docker, o compose substitui "localhost" por "db")
DATABASE_URL=postgres://agroalerta:agroalerta@localhost:5432/agroalerta
