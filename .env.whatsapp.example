# Segredos da integração WhatsApp (docker-compose.whatsapp.yml).
#
# Copie este arquivo para ".env" (exatamente esse nome, na raiz do projeto: o
# .gitignore já o ignora) e preencha cada valor com um segredo aleatório:
#
#   openssl rand -hex 32
#
# Use só letras, números, ".", "_" e "-", com 24+ caracteres. Cada valor vira um Docker
# secret em /run/secrets: não fica nas variáveis dos containers nem no Git.
# Vazios, os serviços da Evolution não sobem (de propósito: nada roda com senha fraca).

# Chave global da Evolution API (cabeçalho "apikey"). Só o backend a usa.
EVOLUTION_API_KEY=

# Chave do JWT que autentica os webhooks da Evolution para o backend.
EVOLUTION_WEBHOOK_SECRET=

# Senhas do PostgreSQL e do Redis exclusivos da Evolution (não são as do Agro Alerta).
EVOLUTION_DB_PASSWORD=
EVOLUTION_REDIS_PASSWORD=

# Só mudar após autorização explícita e validação do remetente.
AGROALERTA_WHATSAPP_SENDING_ENABLED=false
AGROALERTA_WEATHER_MONITOR_ENABLED=false

# Em produção, prefira o número completo autorizado (DDI + DDD + celular).
AGROALERTA_WHATSAPP_EXPECTED_SENDER=9503

# Novas funcionalidades: manter desativadas até autorização específica.
AGROALERTA_WEATHER_BULLETIN_ENABLED=false
AGROALERTA_WEATHER_EXTENDED_ALERTS_ENABLED=false
